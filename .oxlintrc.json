{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "jsPlugins": ["./tools/oxlint/ban-comments.js"],
  "categories": {
    "correctness": "off",
    "nursery": "off",
    "pedantic": "off",
    "perf": "off",
    "restriction": "off",
    "style": "off",
    "suspicious": "off"
  },
  "ignorePatterns": ["**/node_modules/**"],
  "rules": {
    "ban-comments/ban-comments": "error"
  }
}
